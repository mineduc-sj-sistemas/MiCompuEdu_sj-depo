# =============================================================================
# Variables de Entorno de Ejemplo — MiCompuEdu_sj (Depósito Ministerio Educación)
# Copiar este archivo como `.env` para ejecución local o en Docker Compose.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Docker Compose / Local)
# -----------------------------------------------------------------------------
POSTGRES_DB=micompuedu_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# URL de conexión completa (requerida en despliegues Cloud como Render):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/micompuedu_db

# -----------------------------------------------------------------------------
# 2. Seguridad y Autenticación JWT (.NET 8 IOptions<JwtOptions>)
# La clave secreta debe tener al menos 32 caracteres en entorno Production.
# -----------------------------------------------------------------------------
JWT_KEY=ClaveSecretaSuperSeguraParaSanJuanDeAlMenos32CaracteresDeProduccion!
Jwt__Key=ClaveSecretaSuperSeguraParaSanJuanDeAlMenos32CaracteresDeProduccion!
JWT_ISSUER=MiCompuEdu_Issuer
Jwt__Issuer=MiCompuEdu_Issuer
JWT_AUDIENCE=MiCompuEdu_Audience
Jwt__Audience=MiCompuEdu_Audience

# -----------------------------------------------------------------------------
# 3. Seguridad CORS (Orígenes Permitidos en Producción separados por coma)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://micompuedu-frontend.onrender.com,http://localhost:5173

# -----------------------------------------------------------------------------
# 4. Integración WhatsApp Business Cloud API (.NET 8 IOptions<WhatsAppOptions>)
# Si se dejan vacíos, el sistema opera en modo simulación segura de desarrollo.
# -----------------------------------------------------------------------------
WHATSAPP_TOKEN=
WhatsApp__AccessToken=
WHATSAPP_PHONE_NUMBER_ID=
WhatsApp__PhoneNumberId=

# -----------------------------------------------------------------------------
# 5. Configuración Frontend (Vite / React)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5110/api/v1
